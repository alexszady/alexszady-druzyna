@startuml
title Diagram aktywności - Dodawanie zawodnika

start

:Wyświetlenie listy zawodników;

:Wybranie opcji "Dodaj zawodnika";

:Wprowadzenie danych zawodnika;

:Sprawdzenie poprawności danych;

if (Dane są poprawne?) then (Tak)
    :Zapisanie zawodnika;
    :Wyświetlenie komunikatu
    "Zawodnik został dodany";
else (Nie)
    :Wyświetlenie komunikatu
    "Nieprawidłowe dane";
    :Ponowne wprowadzenie danych;
endif

stop
@enduml
